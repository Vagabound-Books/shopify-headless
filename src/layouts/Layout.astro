---
import 'dotenv/config';
import CartDrawer from '../components/CartDrawer.tsx';
import ShopifyAnalyticsInit from '../components/ShopifyAnalyticsInit.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  analytics?: {
    pageType?: string;
    resourceId?: string;
    collectionHandle?: string;
    collectionId?: string;
    searchString?: string;
    products?: Array<{
      productGid: string;
      variantGid?: string;
      name: string;
      variantName?: string;
      brand?: string;
      category?: string;
      price: string;
      sku?: string;
      quantity?: number;
    }>;
    totalValue?: number;
  };
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  noindex = false,
  prevUrl,
  nextUrl,
  jsonLd,
  analytics,
} = Astro.props;

const siteTitle = title ? `${title} | Vagabound Books` : 'Vagabound Books — a home for migratory words';
const pageTitle = siteTitle;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;

function resolveUrl(pathOrUrl: string): string {
  if (pathOrUrl.startsWith('http')) return pathOrUrl;
  const base = siteUrl.replace(/\/$/, '');
  const path = pathOrUrl.startsWith('/') ? pathOrUrl : `/${pathOrUrl}`;
  return `${base}${path}`;
}

const canonical = canonicalUrl ? resolveUrl(canonicalUrl) : `${siteUrl.replace(/\/$/, '')}${Astro.url.pathname}`;
const ogImageUrl = ogImage ? resolveUrl(ogImage) : `${siteUrl.replace(/\/$/, '')}/og-image.png`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vagabound Books',
  url: `${siteUrl.replace(/\/$/, '')}/`,
  logo: resolveUrl('/assets/vagabound-logo.png'),
  sameAs: [
    'https://www.instagram.com/vagaboundbooks/',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vagabound Books',
  url: `${siteUrl.replace(/\/$/, '')}/`,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl.replace(/\/$/, '')}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const structuredData = jsonLd
  ? [organizationSchema, websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [organizationSchema, websiteSchema];

const shopifyClientConfig = JSON.stringify({
  storeDomain: process.env.SHOPIFY_STORE_DOMAIN || '',
  storefrontAccessToken: process.env.SHOPIFY_STOREFRONT_ACCESS_TOKEN || '',
  apiVersion: process.env.SHOPIFY_API_VERSION || '2024-07',
});

const ga4MeasurementId = 'G-7KYXF4DM12';
const ga4LinkerDomains = JSON.stringify(['checkout.vagaboundbooks.com']);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#11314D">
    <meta name="msapplication-config" content="/browserconfig.xml">
    <meta name="theme-color" content="#11314D">

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Vagabound" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preconnect to Shopify CDN -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Adobe Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/qbg0hqo.css">

    <!-- Google Fonts fallback -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Nunito:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Styles -->
    <style is:global>
      @import '../styles/theme.css';
      @import '../styles/swish-theme.css';
    </style>

    <!-- Structured data -->
    {structuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Shopify client config -->
    <script is:inline set:html={`window.__SHOPIFY_CONFIG__ = ${shopifyClientConfig};`} />

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
    <script is:inline define:vars={{ ga4MeasurementId, ga4LinkerDomains }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;

      // Consent Mode v2 defaults: deny everything except security until the user consents.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      gtag('js', new Date());
      gtag('config', ga4MeasurementId, {
        linker: {
          domains: JSON.parse(ga4LinkerDomains),
        },
        send_page_view: true,
        allow_google_signals: true,
        allow_ad_personalization_signals: false,
      });
    </script>
    <!-- TikTok Click ID capture -->
    <script>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var ttclid = params.get('ttclid');
          if (!ttclid) return;
          var host = window.location.host;
          var domain = host.indexOf('localhost') === 0 ? '' : '.' + host.replace(/^www\./, '');
          var cookie = 'ttclid=' + encodeURIComponent(ttclid) + '; Max-Age=' + (60 * 60 * 24 * 30) + '; Path=/; SameSite=Lax';
          if (domain) cookie += '; Domain=' + domain;
          document.cookie = cookie;
        } catch (e) {
          // ignore
        }
      })();
    </script>
    <!-- TikTok Pixel Code Start -->
    <script>
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(
      var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script")
      ;n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};

        ttq.load(import.meta.env.PUBLIC_TIKTOK_PIXEL_ID);
        ttq.page();
      }(window, document, 'ttq');
    </script>
    <!-- TikTok Pixel Code End -->
  </head>

  <body>
    <slot name="header" />
    <CartDrawer client:idle />

    <main class="vb-main">
      <slot />
    </main>

    <slot name="footer" />

    <ShopifyAnalyticsInit {...analytics} />

    <button type="button" class="vb-back-to-top js-back-to-top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <script is:inline>
      // Mobile menu toggle
      (function() {
        const toggle = document.querySelector('.js-mobile-toggle');
        const close = document.querySelector('.js-mobile-close');
        const nav = document.querySelector('.js-mobile-nav');
        if (!toggle || !nav) return;
        toggle.addEventListener('click', function() {
          document.body.classList.toggle('is-mobile-nav-open');
        });
        if (close) {
          close.addEventListener('click', function() {
            document.body.classList.remove('is-mobile-nav-open');
          });
        }
        nav.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', function() {
            document.body.classList.remove('is-mobile-nav-open');
          });
        });
      })();

      // Back to top
      (function() {
        const btn = document.querySelector('.js-back-to-top');
        if (!btn) return;
        function toggle() {
          btn.classList.toggle('is-visible', window.scrollY > 400);
        }
        window.addEventListener('scroll', toggle, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        toggle();
      })();

      // Drag-to-scroll for horizontal rows
      (function() {
        document.querySelectorAll('.vb-scroll-row').forEach(function(row) {
          var isDown = false;
          var startX;
          var scrollLeft;

          function isScrollable() {
            return getComputedStyle(row).overflowX === 'auto';
          }

          row.addEventListener('mousedown', function(e) {
            if (!isScrollable()) return;
            isDown = true;
            row.classList.add('is-dragging');
            startX = e.pageX - row.offsetLeft;
            scrollLeft = row.scrollLeft;
          });

          row.addEventListener('mouseleave', function() {
            isDown = false;
            row.classList.remove('is-dragging');
          });

          row.addEventListener('mouseup', function() {
            isDown = false;
            row.classList.remove('is-dragging');
          });

          row.addEventListener('mousemove', function(e) {
            if (!isDown) return;
            e.preventDefault();
            var x = e.pageX - row.offsetLeft;
            var walk = (x - startX) * 1.5;
            row.scrollLeft = scrollLeft - walk;
          });
        });
      })();

      // Scroll row navigation buttons
      (function() {
        function scrollRow(btn, direction) {
          var section = btn.closest('section');
          if (!section) return;
          var row = section.querySelector('.js-scroll-row');
          if (!row) return;
          var card = row.querySelector('.vb-scroll-card');
          var amount = card ? (card.offsetWidth + 20) : 200;
          row.scrollBy({ left: direction * amount, behavior: 'smooth' });
        }

        document.querySelectorAll('.js-scroll-prev').forEach(function(btn) {
          btn.addEventListener('click', function() { scrollRow(btn, -1); });
        });

        document.querySelectorAll('.js-scroll-next').forEach(function(btn) {
          btn.addEventListener('click', function() { scrollRow(btn, 1); });
        });
      })();
    </script>

    <script is:inline>
      // Global behavior tracking for GA4
      (function () {
        function gtagEvent(name, params) {
          if (typeof window === 'undefined' || !window.gtag) return;
          window.gtag('event', name, params || {});
        }

        function isOutbound(href) {
          if (!href || href.indexOf('http') !== 0) return false;
          try {
            return new URL(href).hostname !== window.location.hostname;
          } catch (e) {
            return false;
          }
        }

        // Outbound link tracking
        document.addEventListener('click', function (e) {
          var el = e.target.closest('a');
          if (!el || !el.href) return;
          if (isOutbound(el.href)) {
            gtagEvent('outbound_link_click', {
              link_url: el.href,
              link_text: el.textContent.trim().slice(0, 100),
              link_domain: new URL(el.href).hostname,
            });
          }
        });

        // Scroll depth: fire once at 90%
        var scrollSent = false;
        window.addEventListener('scroll', function () {
          if (scrollSent) return;
          var doc = document.documentElement;
          var scrollable = doc.scrollHeight - doc.clientHeight;
          if (scrollable <= 0) return;
          var scrollPercent = (window.scrollY / scrollable) * 100;
          if (scrollPercent >= 90) {
            scrollSent = true;
            gtagEvent('scroll_90', { percent_scrolled: 90 });
          }
        }, { passive: true });

        // Product card select_item tracking (grid cards and scroll-row cards)
        document.addEventListener('click', function (e) {
          var card = e.target.closest('a.vb-card, a.vb-scroll-card');
          if (!card) return;
          // Skip the "browse more" placeholder card
          if (card.classList.contains('vb-scroll-card--more')) return;
          var section = card.closest('[data-ga-list-name]');
          var listName = section ? section.getAttribute('data-ga-list-name') : undefined;
          var productData = card.getAttribute('data-ga-product');
          if (!productData) return;
          try {
            var product = JSON.parse(productData);
            gtagEvent('select_item', {
              item_list_name: listName,
              items: [{
                item_id: product.sku || product.variantGid || product.productGid,
                item_name: product.name,
                item_brand: product.brand,
                item_category: product.category,
                item_variant: product.variantName,
                price: parseFloat(product.price) || 0,
                currency: product.currency,
              }],
            });
          } catch (err) {
            // ignore malformed data attributes
          }
        });
      })();
    </script>
  </body>
</html>
