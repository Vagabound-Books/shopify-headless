---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NotFoundPage from '../../components/NotFoundPage.astro';
import ProductCard from '../../components/ProductCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollectionPage, parseSort, SORT_OPTIONS } from '../../lib/pagination';
import { getCustomerAccountsTokens } from '../../lib/customer-accounts';

function stripHtml(html: string, maxLength: number = 160): string {
  const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
  if (text.length <= maxLength) return text;
  return text.slice(0, maxLength - 1).trimEnd() + '…';
}

const { handle } = Astro.params;

if (!handle) {
  Astro.response.status = 404;
}

const rawPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const sort = parseSort(Astro.url.searchParams.get('sort'));

const result = !handle ? null : await getCollectionPage({
  handle,
  page: rawPage,
  sort,
  buyerIP: Astro.clientAddress,
}).catch((err) => {
  console.error('[Shopify] Failed to fetch collection:', err);
  return null;
});

if (!result) {
  Astro.response.status = 404;
}

const { collection, products, page, totalPages, totalCount, rangeStart, rangeEnd, sort: activeSort } = result || {};
const { accessToken } = getCustomerAccountsTokens(Astro.cookies);
const isAuthenticated = !!accessToken;

const pageTitle = collection?.seo?.title || collection?.title || '';
const metaDescription = collection?.seo?.description
  ? stripHtml(collection.seo.description, 160)
  : collection?.descriptionHtml
    ? stripHtml(collection.descriptionHtml, 160)
    : (collection ? `Browse ${collection.title} at Vagabound Books.` : undefined);

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, '');

function buildCollectionUrl(handle: string, pageNum: number, sortKey: SortKey): string {
  const params = new URLSearchParams();
  if (pageNum > 1) params.set('page', String(pageNum));
  if (sortKey !== 'featured') params.set('sort', sortKey);
  const query = params.toString();
  return `${siteUrl}/collections/${handle}/${query ? `?${query}` : ''}`;
}

const canonicalUrl = collection ? buildCollectionUrl(collection.handle, page || 1, activeSort || 'featured') : '';
const prevUrl = collection && page && page > 1
  ? buildCollectionUrl(collection.handle, page - 1, activeSort || 'featured')
  : undefined;
const nextUrl = collection && page && totalPages && page < totalPages
  ? buildCollectionUrl(collection.handle, page + 1, activeSort || 'featured')
  : undefined;
const ogImageUrl = collection?.image?.url ? collection.image.url : undefined;

const breadcrumbSchema = collection ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Collections', item: `${siteUrl}/collections/` },
    { '@type': 'ListItem', position: 3, name: collection.title, item: buildCollectionUrl(collection.handle, 1, 'featured') },
  ],
} : undefined;

const collectionPageSchema = collection ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: metaDescription,
  url: canonicalUrl,
  image: ogImageUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: (products || []).map((product: any, index: number) => ({
      '@type': 'ListItem',
      position: (rangeStart || 0) + index,
      url: `${siteUrl}/books/${product.handle}/`,
      name: product.title,
      image: product.featuredImage?.url,
    })),
  },
} : undefined;

const analytics = {
  pageType: 'collection',
  resourceId: collection?.id,
  collectionHandle: collection?.handle,
  collectionId: collection?.id,
};
---

{!collection ? (
  <NotFoundPage />
) : (
  <Layout
    title={pageTitle}
    description={metaDescription}
    canonicalUrl={canonicalUrl}
    ogImage={ogImageUrl}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    jsonLd={breadcrumbSchema && collectionPageSchema ? [breadcrumbSchema, collectionPageSchema] : undefined}
    analytics={analytics}
  >
    <Header slot="header" />

    <div class="vb-container">
      <div class="vb-coll-head">
        <div class="vb-coll-head__top">
          <div class="vb-coll-head__title">
            <div class="vb-coll-head__crumb">
              <a href="/">Shop</a>
              <span class="sep">/</span>
              <a href="/collections">All shelves</a>
              <span class="sep">/</span>
              <span class="now">{collection.title}</span>
            </div>
            <h1>{collection.title}</h1>
          </div>

          {collection.descriptionHtml && (
            <div class="vb-coll-head__desc" set:html={collection.descriptionHtml} />
          )}
        </div>
      </div>
    </div>

    <div class="vb-container">
      <div class="vb-coll" style="grid-template-columns: 1fr;">
        <div class="vb-coll__main">
          <div class="vb-coll__bar">
            <div class="left">
              {totalCount > 0 ? (
                <>Showing <strong>{rangeStart}–{rangeEnd}</strong> of {totalCount} books</>
              ) : (
                <>Showing <strong>0</strong> books</>
              )}
            </div>
            <div class="right">
              <form method="get" action={`/collections/${handle}/`} class="vb-sort">
                <label for="sort">Sort</label>
                <select id="sort" name="sort" onchange="this.form.submit()">
                  {SORT_OPTIONS.map((option) => (
                    <option value={option.value} selected={option.value === activeSort}>{option.label}</option>
                  ))}
                </select>
                <noscript>
                  <button type="submit" class="vb-btn vb-btn--sm">Apply</button>
                </noscript>
              </form>
            </div>
          </div>

          <div class="vb-shelf" data-ga-list-name={`collection:${collection.handle}`}>
            {products.map((product: any) => (
              <ProductCard product={product} isAuthenticated={isAuthenticated} />
            ))}
          </div>

          <Pagination page={page} totalPages={totalPages} baseUrl={`/collections/${handle}/`} sort={activeSort} />
        </div>
      </div>
    </div>

    <Footer slot="footer" />
  </Layout>
)}
