---
import ConsentBanner from './ConsentBanner.tsx';
import { SHOPIFY_Y, SHOPIFY_S, buildUUID } from '../lib/analytics/cookies';

export interface Props {
  pageType?: string;
  resourceId?: string;
  collectionHandle?: string;
  collectionId?: string;
  searchString?: string;
  products?: Array<{
    productGid: string;
    variantGid?: string;
    name: string;
    variantName?: string;
    brand?: string;
    category?: string;
    price: string;
    sku?: string;
    quantity?: number;
  }>;
  totalValue?: number;
}

const {
  pageType,
  resourceId,
  collectionHandle,
  collectionId,
  searchString,
  products,
  totalValue,
} = Astro.props;

const rawShopId = process.env.SHOPIFY_SHOP_ID;
if (!rawShopId) {
  throw new Error('[ShopifyAnalyticsInit] SHOPIFY_SHOP_ID environment variable is required');
}
const shopId = rawShopId;
const currency = 'USD';
const acceptedLanguage = 'EN';
const storefrontAccessToken = process.env.SHOPIFY_STOREFRONT_ACCESS_TOKEN || '';
const checkoutDomain = 'checkout.vagaboundbooks.com';
const storefrontDomain = process.env.PUBLIC_STORE_DOMAIN || 'vagaboundbooks.com';
const alwaysShowConsentBanner = import.meta.env.PUBLIC_ALWAYS_SHOW_CONSENT_BANNER === 'true';

function getSharedCookieDomain(domain: string): string {
  if (!domain || /^localhost/.test(domain)) return '';
  // Strip any leading protocol/port and use a leading dot so subdomains (checkout) share it.
  const host = domain.replace(/^https?:\/\//, '').split(':')[0];
  return `.${host}`;
}

function getOrCreateToken(name: string): string {
  const existing = Astro.cookies.get(name);
  if (existing?.value) return existing.value;

  const token = typeof crypto !== 'undefined' && crypto.randomUUID
    ? crypto.randomUUID()
    : buildUUID();

  const maxAge = name === SHOPIFY_Y ? 60 * 60 * 24 * 365 : 60 * 30;
  const cookieDomain = getSharedCookieDomain(storefrontDomain);
  const isLocalhost = !cookieDomain;

  Astro.cookies.set(name, token, {
    maxAge,
    path: '/',
    sameSite: 'lax',
    secure: !isLocalhost,
    httpOnly: false,
    domain: cookieDomain || undefined,
  });

  return token;
}

const uniqueToken = getOrCreateToken(SHOPIFY_Y);
const visitToken = getOrCreateToken(SHOPIFY_S);

const analyticsConfig = JSON.stringify({
  shopId,
  currency,
  acceptedLanguage,
  storefrontAccessToken,
  checkoutDomain,
  storefrontDomain,
  uniqueToken,
  visitToken,
  assetVersionId: 'headless/1.0',
  pageType,
  resourceId,
  collectionHandle,
  collectionId,
  searchString,
  products,
  totalValue,
});
---

<script is:inline src="https://cdn.shopify.com/shopifycloud/consent-tracking-api/v0.1/consent-tracking-api.js" async></script>

<script is:inline set:html={`window.__VB_ANALYTICS__ = ${analyticsConfig};`} />

<script>
  import { sendShopifyAnalytics } from '../lib/analytics/monorail';
  import {
    updateConsentFromPrivacyApi,
    sendGa4PageView,
    sendGa4ViewItem,
    sendGa4ViewItemList,
    sendGa4Search,
  } from '../lib/analytics/ga4';
  import type { ShopifyAnalyticsProduct } from '../lib/analytics/monorail';

  declare global {
    interface Window {
      __sendShopifyAnalytics?: typeof sendShopifyAnalytics;
      __VAGABOUND_GA4__?: {
        updateConsent: () => void;
        sendPageView: (params?: Record<string, unknown>) => void;
        sendViewItem: (product: ShopifyAnalyticsProduct) => void;
        sendViewItemList: (products: ShopifyAnalyticsProduct[], itemListName?: string) => void;
        sendSearch: (term: string) => void;
      };
    }
  }

  window.__sendShopifyAnalytics = sendShopifyAnalytics;
  window.__VAGABOUND_GA4__ = {
    updateConsent: updateConsentFromPrivacyApi,
    sendPageView: sendGa4PageView,
    sendViewItem: sendGa4ViewItem,
    sendViewItemList: sendGa4ViewItemList,
    sendSearch: sendGa4Search,
  };

  // Layout.astro initializes GA4 consent mode defaults before gtag config.
  // This component only updates consent and sends page views / e-commerce events.
</script>

<script is:inline>
  (function () {
    var pageViewSent = false;

    function whenReady(callback) {
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(callback, 1);
      } else {
        document.addEventListener('DOMContentLoaded', callback);
      }
    }

    function getApiAndSender() {
      return {
        api: window.Shopify && window.Shopify.customerPrivacy,
        sender: window.__sendShopifyAnalytics,
      };
    }

    function getBrowserParams() {
      if (typeof window === 'undefined' || !window.location) {
        return {};
      }
      return {
        url: window.location.href,
        path: window.location.pathname,
        search: window.location.search,
        referrer: document.referrer,
        title: document.title,
        userAgent: navigator.userAgent,
      };
    }

    function sendGa4PageForConfig(config) {
      if (!window.__VAGABOUND_GA4__) return;
      window.__VAGABOUND_GA4__.sendPageView({
        pageType: config.pageType,
        resourceId: config.resourceId,
      });

      if (config.pageType === 'product' && config.products && config.products.length > 0) {
        window.__VAGABOUND_GA4__.sendViewItem(config.products[0]);
      } else if (config.pageType === 'collection' && config.products && config.products.length > 0) {
        window.__VAGABOUND_GA4__.sendViewItemList(config.products, config.collectionHandle);
      } else if (config.pageType === 'search' && config.searchString) {
        window.__VAGABOUND_GA4__.sendSearch(config.searchString);
      }
    }

    function trySendPageView() {
      var config = window.__VB_ANALYTICS__;
      if (!config) return;
      var api = getApiAndSender().api;
      var sender = getApiAndSender().sender;
      if (!api || !sender) return;

      // Sync gtag consent mode with Shopify's current permission state before sending.
      if (window.__VAGABOUND_GA4__) {
        window.__VAGABOUND_GA4__.updateConsent();
      }

      if (!api.analyticsProcessingAllowed()) return;
      if (pageViewSent) return;
      pageViewSent = true;

      sender({
        eventName: 'PAGE_VIEW',
        payload: {
          hasUserConsent: true,
          shopId: config.shopId,
          currency: config.currency,
          acceptedLanguage: config.acceptedLanguage,
          assetVersionId: config.assetVersionId,
          shopifySalesChannel: 'headless',
          analyticsAllowed: api.analyticsProcessingAllowed(),
          marketingAllowed: api.marketingAllowed(),
          saleOfDataAllowed: api.saleOfDataAllowed(),
          uniqueToken: config.uniqueToken,
          visitToken: config.visitToken,
          pageType: config.pageType,
          resourceId: config.resourceId,
          collectionHandle: config.collectionHandle,
          collectionId: config.collectionId,
          searchString: config.searchString,
          products: config.products,
          totalValue: config.totalValue,
          ...getBrowserParams(),
        },
      });

      sendGa4PageForConfig(config);
    }

    whenReady(function () {
      var attempts = 0;
      var maxAttempts = 50;
      var interval = setInterval(function () {
        attempts++;
        var api = getApiAndSender().api;
        var sender = getApiAndSender().sender;
        if ((api && sender) || attempts >= maxAttempts) {
          clearInterval(interval);
          trySendPageView();
        }
      }, 100);
    });

    window.addEventListener('vagabound:consentUpdated', function () {
      if (window.__VAGABOUND_GA4__) {
        window.__VAGABOUND_GA4__.updateConsent();
      }
      pageViewSent = false;
      trySendPageView();
    });
  })();
</script>

<ConsentBanner
  client:load
  storefrontAccessToken={storefrontAccessToken}
  checkoutRootDomain={checkoutDomain}
  storefrontRootDomain={storefrontDomain}
  alwaysShow={alwaysShowConsentBanner}
/>

<style is:global>
  .vb-consent-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--paper);
    border-bottom: 1.5px solid var(--rule-firm);
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
  }

  .vb-consent-banner__inner {
    max-width: var(--container-width, 1440px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .vb-consent-banner__text {
    margin: 0;
  }

  .vb-consent-banner__text a {
    color: var(--buckram);
    text-decoration: underline;
  }

  .vb-consent-banner__actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .vb-consent-banner__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .vb-consent-banner__actions {
      width: 100%;
    }

    .vb-consent-banner__actions .vb-btn {
      flex: 1;
    }
  }
</style>
