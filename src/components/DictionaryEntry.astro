---
export interface Props {
  word?: string;
  phonetic?: string;
  partOfSpeech?: string;
  definitions?: string[];
  etymology?: string;
  example?: string;
}

const {
  word = 'Vagabound',
  phonetic = '/ˈvæɡəˌbaʊnd/',
  partOfSpeech = 'noun',
  definitions = [
    "A book that has traveled through many hands and shelves before finding its next reader.",
    "A bookstore that trades in single-copy used editions referred to as 'Vagabound' editions."
    "A reader ambiently wandering the shelves with a specialized kind of bibliomania.",
  ],
  etymology = 'From Latin vagabundus, wandering.',
  example = '“Every vagabound on our shelves carries its own provenance.”',
} = Astro.props;
---

<section class="vb-section vb-section--tight vb-dictionary-section">
  <div class="vb-container">
    <div class="vb-dictionary">
      <div class="vb-dictionary__header">
        <h2 class="vb-dictionary__word">{word}</h2>
        <span class="vb-dictionary__phonetic" aria-label="pronunciation">{phonetic}</span>
      </div>
      <span class="vb-dictionary__pos">{partOfSpeech}</span>
      <ol class="vb-dictionary__definitions">
        {definitions.map((definition) => (
          <li>{definition}</li>
        ))}
      </ol>
      {(etymology || example) && (
        <div class="vb-dictionary__meta">
          {etymology && <p class="vb-dictionary__etymology">{etymology}</p>}
          {example && <p class="vb-dictionary__example">{example}</p>}
        </div>
      )}
    </div>
  </div>
  <h3>What kind of traveler are you?</h3>
</section>

<style>
  .vb-dictionary {

  }

  .vb-dictionary__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .vb-dictionary__word {
    font-family: var(--font-display);
    font-size: clamp(var(--type-3xl), 6vw, var(--type-5xl));
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    color: var(--ink);
  }

  .vb-dictionary__phonetic {
    font-family: var(--font-mono);
    font-size: var(--type-base);
    color: var(--ink-muted);
  }

  .vb-dictionary__pos {
    display: block;
    font-family: var(--font-display);
    font-size: var(--type-sm);
    font-style: italic;
    color: var(--ink-soft);
    margin-bottom: var(--space-5);
  }

  .vb-dictionary__definitions {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-6);
    font-family: var(--font-body);
    font-size: var(--type-lg);
    line-height: var(--leading-body);
    color: var(--ink-soft);
  }

  .vb-dictionary__definitions li {
    padding-left: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .vb-dictionary__definitions li:last-child {
    margin-bottom: 0;
  }

  .vb-dictionary__meta {
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-faint);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .vb-dictionary__etymology,
  .vb-dictionary__example {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-sm);
    line-height: var(--leading-body);
    color: var(--ink-muted);
  }

  .vb-dictionary__example {
    font-style: italic;
  }

  @media (max-width: 640px) {
    .vb-dictionary {
      padding: var(--space-5) var(--space-4);
    }

    .vb-dictionary__definitions {
      font-size: var(--type-base);
      padding-left: var(--space-5);
    }
  }
</style>
